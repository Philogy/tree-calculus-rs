bin_to_nat = mk_rec2 (fn re base -> 
    $
        ($ nat0 $)
        (fn bit rem -> nat_add (bit nat0 base) (re (nat_add base base) rem))
) nat1


bin_add = mk_rec3 (fn re carry x -> 
    match_list
        (carry x (bin_succ x)) // y = 0, if carry 0 => x, else x + 1.
        (fn b_y y_rem -> 
            match_list
                (carry (cons b_y y_rem) (bin_succ (cons b_y y_rem)))
                (fn b_x x_rem ->
                    carry
                        (b_y
                            (cons b_x (re b0 x_rem y_rem))            // 0 + 0 + b_x
                            (cons (bit_not b_x) (re b_x x_rem y_rem)) // 0 + 1 + b_x
                        )
                        (b_y
                            (cons (bit_not b_x) (re b_x x_rem y_rem)) // 1 + 0 + b_x
                            (cons b_x (re b1 x_rem y_rem))            // 1 + 1 + b_x
                        )
                )
            x
        )
) b0

