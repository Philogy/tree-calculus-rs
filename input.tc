b0 = K
b1 = K id
bit_not = fn bit -> bit b1 b0


nil = $
cons = $

match_list = fn on_nil on_cons -> $ ($ on_nil $) on_cons

bin_succ = mk_rec1 (fn re ->
    match_list
        ($ b1 $)
        (fn bit rem -> bit ($ b1 rem) ($ b0 (re rem)))
)

