data = concat to amount

sufficient_bal = cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_d3 (cons hex_7f (cons hex_5b (cons hex_41 (cons hex_48 (cons hex_f4 (cons hex_00 (cons hex_00 nil)))))))))))))))))))))))))))))))

insufficient_bal = cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_0f (cons hex_67 (cons hex_83 (cons hex_1e (cons hex_74 (cons hex_af (cons hex_00 (cons hex_00 nil)))))))))))))))))))))))))))))))

step1_result = mini_token $ msg_sender data
#viz step1_result
step1_state = prog_result_state step1_result
step1_op = prog_result_op step1_result
step1_addr = prog_result_cmd_data step1_result

#bytes cons step1_op nil
#bytes step1_addr


step2_result_insufficient = mini_token step1_state TX_ENV_ADDR insufficient_bal
step2_insufficient_op = prog_result_op step2_result_insufficient

#bytes cons step2_insufficient_op nil

step2_result_sufficient = mini_token step1_state TX_ENV_ADDR sufficient_bal
step2_sufficient_op = prog_result_op step2_result_sufficient
step2_sufficient_key = fork_lhs (prog_result_cmd_data step2_result_sufficient)
step2_sufficient_delta = fork_rhs (prog_result_cmd_data step2_result_sufficient)

#bytes cons step2_sufficient_op nil
#bytes step2_sufficient_key
#viz step2_sufficient_delta

#show b0
#show b1

step3_result = mini_token (prog_result_state step2_result_sufficient) TX_ENV_ADDR nil
step3_op = prog_result_op step3_result
step3_key = fork_lhs (prog_result_cmd_data step3_result)
step3_delta = fork_rhs (prog_result_cmd_data step3_result)
step3_state = prog_result_state step3_result

#bytes cons step3_op nil
#bytes step3_key

#num bool_to_nat (tree_eq step3_delta step2_sufficient_delta)

step4_result = mini_token step3_state TX_ENV_ADDR nil

step4_op = prog_result_op step4_result
step4_state = prog_result_state step4_result

#bytes cons step4_op nil
#show prog_result_cmd_data step4_result
