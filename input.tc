mk_prog_input = fn state sender data -> $ ($ state sender) data
prog_input_get_state =  $ ($$$) (fn lhs rhs -> $ ($$$) K lhs)
prog_input_get_sender =  $ ($$$) (fn lhs rhs -> $ ($$$) (K id) lhs)
prog_input_get_data =  $ ($$$) (K id)

