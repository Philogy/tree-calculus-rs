addr_to_b32 = repeat (cons hex_00) nat12

// :: [a] -> nat -> [a]
slice_start = mk_rec2 fn re list -> match_nat nil (fn u -> 
    match_list
        nil
        (fn head tail -> cons head (re tail u))
        list
)

// :: [a] -> nat -> [a]
slice_end = mk_rec2 fn re list -> match_nat list (fn u -> 
    match_list
        nil
        (fn head tail -> re tail u)
        list
)

concat = mk_rec2 fn re l1 l2 -> (
    match_list
        l2
        (fn head tail -> cons head (re tail l2))
        l1
)


STOP_OP = hex_00
SINC_OP = hex_01
SDEC_OP = hex_02
SLOAD_OP = hex_03

TX_ENV_ADDR = cons hex_01 nil

// :: new_state -> cmd -> prog_result
prog_result = fn new_state op cmd_data -> $ new_state ($ op cmd_data)
prog_result_state = fork_lhs
prog_result_op = comp fork_lhs fork_rhs
prog_result_cmd_data = comp fork_rhs fork_rhs


CMP_EQ = $
CMP_LT = $$
CMP_GT = $$$

cmp_bit = fn x y -> x (y CMP_EQ CMP_LT) (y CMP_GT CMP_EQ)
cmp_is_eq = $ ($ true (K false)) (K (K false))
cmp_is_lt = $ ($ false (K true)) (K (K false))
cmp_is_gt = $ ($ false (K false)) (K (K true))
cmp_is_le = $ ($ true (K true)) (K (K false))
cmp_is_ge = $ ($ true (K false)) (K (K true))

// :: bin -> bool
bin_iszero = mk_rec1 fn re -> match_list true (fn bit tail -> bit (re tail) false)

cmp_bin = mk_rec2 fn cmp_bin x y -> (
    then x (match_list
        (if (bin_iszero y) CMP_EQ CMP_LT)
        (fn x_bit x_tail -> then y (match_list
            (if (bin_iszero x) CMP_EQ CMP_GT)
            (fn y_bit y_tail ->
                then (cmp_bin x_tail y_tail) fn tail_cmp ->
                    if (cmp_is_eq tail_cmp)
                        (cmp_bit x_bit y_bit)
                        tail_cmp
            )
        ))
    )
)

bin_gt = fn x y -> cmp_is_gt (cmp_bin x y)


