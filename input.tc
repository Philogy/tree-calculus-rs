bin_push_byte = mk_rec2 fn re num -> (
    match_list
        num
        (fn bit rem ->
            match_list
                (bit nil (cons b1 nil))
                (fn head tail -> cons bit (cons head tail))
                (re num rem)
        )

)

big_endian_b32_to_bin = (mk_rec2 fn re res -> (
    match_list
        res
        (fn byte rem -> re (bin_push_byte res byte) rem)
)) nil

read_u256 = fn data -> big_endian_b32_to_bin (slice_start data nat32)

mini_token = fn state msg_sender data -> (
    then state (
        // Init
        $ ($ (
            then (slice_start data nat20) fn to ->
            then (read_u256 (slice_end data nat20)) fn amount ->
            then ($ ($ msg_sender ($ to amount)) nat0) fn new_state ->
            then (addr_to_b32 msg_sender) fn sender_bal_key ->
                prog_result new_state SLOAD_OP sender_bal_key
        )$) (fn state_data ->
            match_nat (
                then (fork_lhs state_data) fn from ->
                then (fork_rhs state_data) fn to_and_amount ->
                then (fork_rhs to_and_amount) fn amount ->
                then (read_u256 data) fn from_bal ->
                if (bin_gt amount from_bal)
                    (prog_result $ STOP_OP $)
                    (
                        then ($ to_and_amount nat1) fn new_state ->
                        then (addr_to_b32 from) fn sender_bal_key ->
                        prog_result new_state SDEC_OP ($ sender_bal_key amount)
                    )
            ) (match_nat (
                then (fork_lhs state_data) fn to ->
                then (fork_rhs state_data) fn amount ->
                then (addr_to_b32 to) fn to_bal_key ->
                then ($ $ nat2) fn new_state ->
                prog_result new_state SINC_OP ($ to_bal_key amount)
            ) (
                K (prog_result $ STOP_OP $)
            ))
        )
    )
)

#num count_tree_nodes mini_token

