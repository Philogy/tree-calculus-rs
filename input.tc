false = $
true = $$

not = $ ($ true ($$$)) $

0 = $
succ = $

1 = succ 0
2 = succ 1
3 = succ 2
4 = succ 3
5 = succ 4
6 = succ 5
7 = succ 6
8 = succ 7
9 = succ 8
10 = succ 9
11 = succ 10
12 = succ 11
13 = succ 12
14 = succ 13
15 = succ 14
16 = succ 15
17 = succ 16
18 = succ 17
19 = succ 18
20 = succ 19

id = $ ($$$) $

#num 20


K = $$
d = $ ($ ($$$)) $
comp = $ ($ (K $)) ($ ($ (K $)) ($$))
ignore2 = comp K K

mk_lazy1 = fn x -> d (K (d (K ($ ($$$) x)))) $
#show mk_lazy1

#show mk_lazy1 $
#show mk_lazy1 $ $
#show mk_lazy1 $ $ $
#show mk_lazy1 $ $ $ $

mk_lazy2 = fn x y -> mk_lazy1 (mk_lazy1 x y)
#show mk_lazy2
#show mk_lazy2 $
#show mk_lazy2 $ $
#show mk_lazy2 $ $ $
#show mk_lazy2 $ $ $ $

mk_lazy3 = fn f1 f2 -> mk_lazy2 (mk_lazy1 f1 f2)

// f -> f f
ff = $ ($ id) id
#show ff


mk_mk_rec = fn lazy_maker -> fn f -> ff (fn re -> lazy_maker f (mk_lazy1 re re))
mk_rec1 = mk_mk_rec mk_lazy1
mk_rec2 = mk_mk_rec mk_lazy2
mk_rec3 = mk_mk_rec mk_lazy3

// infinity = mk_lazy1 mk_rec mk_rec
// #show infinity

add = mk_rec2 fn re x -> (
    $ ($ x (comp succ (re x))) $
)

#show add
#show add 2

#num add 0 0
#num add 0 1
#num add 1 0

#num add 2 2
#num add 2 4
#num add 4 2
#num add 3 3
#num add 10 3

count_tree_nodes = mk_rec2 (fn re sum -> comp succ ($
    ($
        sum
        (re sum))
    (fn lhs -> re (re sum lhs))
)) 0

#num count_tree_nodes count_tree_nodes
#num count_tree_nodes add
#num count_tree_nodes mk_lazy3

#viz count_tree_nodes
#viz add

