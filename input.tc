amount = cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_00 (cons hex_11 (cons hex_11 (cons hex_d6 (cons hex_7b (cons hex_b1 (cons hex_bb (cons hex_00 (cons hex_00 nil)))))))))))))))))))))))))))))))
