tree_eq = mk_rec2 fn re x -> (
    $
    ($
        ($ ($ true        (K false)) (K2 false) x)
        ($ ($ (K false)      re    ) (K3 false) x)
    )
        ($ ($ (K2 false) (K3 false)) (fn xl xr yl yr -> if (re xl yl) (re xr yr) false) x)
)

